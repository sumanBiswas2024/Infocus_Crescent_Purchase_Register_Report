<mvc:View
    controllerName="purchaseregisterreport.controller.PurchaseRegister"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:ui="sap.ui.table"
    xmlns:core="sap.ui.core"
>
    <f:DynamicPage
        id="dynamicPageId"
        headerExpanded="true"
        showFooter="false"
        fitContent="true"
        class="sapUiNoContentPadding"
    >
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <HBox
                        alignItems="Center"
                        renderType="Bare"
                    >
                        <Title
                            text="Standard"
                            level="H2"
                            class="sapUiTinyMarginEnd"
                        />
                        <Text
                            text="*"
                            class="sapUiTinyMarginEnd"
                        />
                        <Button
                            icon="sap-icon://slim-arrow-down"
                            type="Transparent"
                            tooltip="Variant"
                        />
                    </HBox>
                </f:heading>
                <f:actions>
                    <Button
                        icon="sap-icon://action"
                        type="Transparent"
                        tooltip="Share"
                    />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <fb:FilterBar
                    id="filterBar"
                    search=".onSearch"
                    showClearOnFB="true"
                    useToolbar="false"
                    clear=".onClear"
                    filterChange=".onFilterChange"
                    class="sapUiSmallMarginTop"
                >
                    <fb:filterGroupItems>
                        <fb:FilterGroupItem
                            groupName="G1"
                            name="PoDateFrom"
                            label="From PO Date:"
                            visibleInFilterBar="true"
                            mandatory="true"
                        >
                            <fb:control>
                                <DatePicker
                                    id="filterPoDateFrom"
                                    valueFormat="yyyy-MM-dd"
                                    displayFormat="dd.MM.yyyy"
                                    tooltip="Select Start Date for Purchase Order"
                                    change=".onDateChange"
                                />
                            </fb:control>
                        </fb:FilterGroupItem>

                        <fb:FilterGroupItem
                            groupName="G1"
                            name="PoDateTo"
                            label="To PO Date:"
                            visibleInFilterBar="true"
                            mandatory="true"
                        >
                            <fb:control>
                                <DatePicker
                                    id="filterPoDateTo"
                                    valueFormat="yyyy-MM-dd"
                                    displayFormat="dd.MM.yyyy"
                                    tooltip="Select End Date for Purchase Order"
                                    change=".onDateChange"
                                />
                            </fb:control>
                        </fb:FilterGroupItem>

                        <fb:FilterGroupItem
                            groupName="G1"
                            name="Pr"
                            label="Purchase Requisition No.:"
                            visibleInFilterBar="true"
                        >
                            <fb:control>
                                <MultiInput
                                    id="filterPr"
                                    showValueHelp="true"
                                    valueHelpRequest=".onValueHelpRequest"
                                    tooltip="Enter Purchase Requisition Number"
                                >
                                    <customData>
                                        <core:CustomData
                                            key="type"
                                            value="string"
                                        />
                                    </customData>
                                </MultiInput>
                            </fb:control>
                        </fb:FilterGroupItem>

                        <fb:FilterGroupItem
                            groupName="G1"
                            name="PrDate"
                            label="PR Date:"
                            visibleInFilterBar="true"
                        >
                            <fb:control>
                                <MultiInput
                                    id="filterPrDate"
                                    showValueHelp="true"
                                    valueHelpRequest=".onValueHelpRequest"
                                    tooltip="Enter Purchase Requisition Creation Date"
                                >
                                    <customData>
                                        <core:CustomData
                                            key="type"
                                            value="date"
                                        />
                                    </customData>
                                </MultiInput>
                            </fb:control>
                        </fb:FilterGroupItem>

                        <fb:FilterGroupItem
                            groupName="G1"
                            name="Po"
                            label="PO No.:"
                            visibleInFilterBar="true"
                        >
                            <fb:control>
                                <MultiInput
                                    id="filterPo"
                                    showValueHelp="true"
                                    valueHelpRequest=".onValueHelpRequest"
                                    tooltip="Enter Purchase Order Number"
                                >
                                    <customData>
                                        <core:CustomData
                                            key="type"
                                            value="string"
                                        />
                                    </customData>
                                </MultiInput>
                            </fb:control>
                        </fb:FilterGroupItem>

                        <fb:FilterGroupItem
                            groupName="G1"
                            name="Material"
                            label="Material Code:"
                            visibleInFilterBar="true"
                        >
                            <fb:control>
                                <MultiInput
                                    id="filterMaterial"
                                    showValueHelp="true"
                                    valueHelpRequest=".onValueHelpRequest"
                                    tooltip="Enter Material Number"
                                >
                                    <customData>
                                        <core:CustomData
                                            key="type"
                                            value="string"
                                        />
                                    </customData>
                                </MultiInput>
                            </fb:control>
                        </fb:FilterGroupItem>

                        <fb:FilterGroupItem
                            groupName="G1"
                            name="Plant"
                            label="PO Plant:"
                            visibleInFilterBar="true"
                        >
                            <fb:control>
                                <MultiInput
                                    id="filterPlant"
                                    showValueHelp="true"
                                    valueHelpRequest=".onValueHelpRequest"
                                    tooltip="Enter Plant Code"
                                >
                                    <customData>
                                        <core:CustomData
                                            key="type"
                                            value="string"
                                        />
                                    </customData>
                                </MultiInput>
                            </fb:control>
                        </fb:FilterGroupItem>

                        <fb:FilterGroupItem
                            groupName="G1"
                            name="GateEntry"
                            label="Gate Entry No.:"
                            visibleInFilterBar="true"
                        >
                            <fb:control>
                                <MultiInput
                                    id="filterGateEntry"
                                    showValueHelp="true"
                                    valueHelpRequest=".onValueHelpRequest"
                                    tooltip="Enter Gate Entry Document Number"
                                >
                                    <customData>
                                        <core:CustomData
                                            key="type"
                                            value="string"
                                        />
                                    </customData>
                                </MultiInput>
                            </fb:control>
                        </fb:FilterGroupItem>
                    </fb:filterGroupItems>
                </fb:FilterBar>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <VBox class="sapUiSmallMarginBeginEnd sapUiSmallMarginTop">
                <ui:Table
                    id="purchaseRegisterTable"
                    selectionMode="MultiToggle"
                    threshold="100"
                    rowActionCount="1"
                    visibleRowCountMode="Fixed"
                    visibleRowCount="7"
                    minAutoRowCount="7"
                    rowHeight="34"
                    columnHeaderHeight="42"
                    width="100%"
                >
                    <ui:extension>
                        <OverflowToolbar>
                            <Title
                                id="tableHeaderTitle"
                                text="Purchase Register"
                                level="H2"
                            />
                            <ToolbarSpacer />
                            <Text
                                id="loadedRowsText"
                                text="Loaded: 0"
                            />
                            <ToolbarSeparator />
                            <Button
                                icon="sap-icon://copy"
                                type="Transparent"
                                tooltip="Copy"
                            />
                            <Button
                                icon="sap-icon://action-settings"
                                type="Transparent"
                                tooltip="Table Settings"
                                press=".onTableSettings"
                            />
                            <Button
                                id="settingsButton"
                                icon="sap-icon://excel-attachment"
                                type="Transparent"
                                tooltip="Export"
                                press=".onExportExcel"
                            />
                        </OverflowToolbar>
                    </ui:extension>
                </ui:Table>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
