<mvc:View
    controllerName="purchaseregisterreport.controller.PurchaseRegister"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:ui="sap.ui.table"
    xmlns:core="sap.ui.core"
    xmlns:rowmodes="sap.ui.table.rowmodes"
>
    <f:DynamicPage
        id="dynamicPageId"
        headerExpanded="true"
        showFooter="false"
        
    >
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title
                        text="Standard"
                        level="H2"
                    />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <fb:FilterBar
                    id="filterBar"
                    search=".onSearch"
                    showClearOnFB="true"
                    useToolbar="false"
                    clear=".onClear"
                    filterChange=".onFilterChange"
                >
                    <fb:filterGroupItems>
                        <fb:FilterGroupItem
                            groupName="G1"
                            name="PoDateFrom"
                            label="From PO Date"
                            visibleInFilterBar="true"
                            mandatory="true"
                        >
                            <fb:control>
                                <DatePicker
                                    id="filterPoDateFrom"
                                    valueFormat="yyyy-MM-dd"
                                    displayFormat="dd.MM.yyyy"
                                    tooltip="Select Start Date for Purchase Order"
                                    change=".onDateChange"
                                />
                            </fb:control>
                        </fb:FilterGroupItem>

                        <fb:FilterGroupItem
                            groupName="G1"
                            name="PoDateTo"
                            label="To PO Date"
                            visibleInFilterBar="true"
                            mandatory="true"
                        >
                            <fb:control>
                                <DatePicker
                                    id="filterPoDateTo"
                                    valueFormat="yyyy-MM-dd"
                                    displayFormat="dd.MM.yyyy"
                                    tooltip="Select End Date for Purchase Order"
                                    change=".onDateChange"
                                />
                            </fb:control>
                        </fb:FilterGroupItem>

                        <fb:FilterGroupItem
                            groupName="G1"
                            name="Pr"
                            label="Purchase Requisition No"
                            visibleInFilterBar="true"
                        >
                            <fb:control>
                                <MultiInput
                                    id="filterPr"
                                    showValueHelp="true"
                                    valueHelpRequest=".onValueHelpRequest"
                                    tooltip="Enter Purchase Requisition Number"
                                >
                                    <customData>
                                        <core:CustomData
                                            key="type"
                                            value="string"
                                        />
                                    </customData>
                                </MultiInput>
                            </fb:control>
                        </fb:FilterGroupItem>

                        <fb:FilterGroupItem
                            groupName="G1"
                            name="PrDate"
                            label="PR Date"
                            visibleInFilterBar="true"
                        >
                            <fb:control>
                                <MultiInput
                                    id="filterPrDate"
                                    showValueHelp="true"
                                    valueHelpRequest=".onValueHelpRequest"
                                    tooltip="Enter Purchase Requisition Creation Date"
                                >
                                    <customData>
                                        <core:CustomData
                                            key="type"
                                            value="date"
                                        />
                                    </customData>
                                </MultiInput>
                            </fb:control>
                        </fb:FilterGroupItem>

                        <fb:FilterGroupItem
                            groupName="G1"
                            name="Po"
                            label="PO No"
                            visibleInFilterBar="true"
                        >
                            <fb:control>
                                <MultiInput
                                    id="filterPo"
                                    showValueHelp="true"
                                    valueHelpRequest=".onValueHelpRequest"
                                    tooltip="Enter Purchase Order Number"
                                >
                                    <customData>
                                        <core:CustomData
                                            key="type"
                                            value="string"
                                        />
                                    </customData>
                                </MultiInput>
                            </fb:control>
                        </fb:FilterGroupItem>

                        <fb:FilterGroupItem
                            groupName="G1"
                            name="Material"
                            label="Material Code"
                            visibleInFilterBar="true"
                        >
                            <fb:control>
                                <MultiInput
                                    id="filterMaterial"
                                    showValueHelp="true"
                                    valueHelpRequest=".onValueHelpRequest"
                                    tooltip="Enter Material Number"
                                >
                                    <customData>
                                        <core:CustomData
                                            key="type"
                                            value="string"
                                        />
                                    </customData>
                                </MultiInput>
                            </fb:control>
                        </fb:FilterGroupItem>

                        <fb:FilterGroupItem
                            groupName="G1"
                            name="Plant"
                            label="PO Plant"
                            visibleInFilterBar="true"
                        >
                            <fb:control>
                                <MultiInput
                                    id="filterPlant"
                                    showValueHelp="true"
                                    valueHelpRequest=".onValueHelpRequest"
                                    tooltip="Enter Plant Code"
                                >
                                    <customData>
                                        <core:CustomData
                                            key="type"
                                            value="string"
                                        />
                                    </customData>
                                </MultiInput>
                            </fb:control>
                        </fb:FilterGroupItem>

                        <fb:FilterGroupItem
                            groupName="G1"
                            name="GateEntry"
                            label="Gate Entry No"
                            visibleInFilterBar="true"
                        >
                            <fb:control>
                                <MultiInput
                                    id="filterGateEntry"
                                    showValueHelp="true"
                                    valueHelpRequest=".onValueHelpRequest"
                                    tooltip="Enter Gate Entry Document Number"
                                >
                                    <customData>
                                        <core:CustomData
                                            key="type"
                                            value="string"
                                        />
                                    </customData>
                                </MultiInput>
                            </fb:control>
                        </fb:FilterGroupItem>
                    </fb:filterGroupItems>
                </fb:FilterBar>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <ui:Table
    id="purchaseRegisterTable"
    selectionMode="MultiToggle"
    threshold="100"
    rowActionCount="1"
    visibleRowCount="Auto">

    <ui:rowMode>
        <rowmodes:Auto
            minRowCount="15"
            maxRowCount="40"/>
    </ui:rowMode>

    <ui:extension>
        <Toolbar>
            <Title
                id="tableHeaderTitle"
                text="Purchase Register "
                level="H2"
            />
            <ToolbarSpacer />
            <ToolbarSeparator/>

    <Text
        id="loadedRowsText"
        text="Loaded: 0"
    />

    <ToolbarSpacer />
            <Button
                icon="sap-icon://excel-attachment"
                tooltip="Export"
                press=".onExportExcel"
            />
            <Button
                 id="settingsButton"
                icon="sap-icon://action-settings"
                tooltip="Settings"
                press=".onTableSettings"
            />
        </Toolbar>
    </ui:extension>

</ui:Table>
        </f:content>
    </f:DynamicPage>
</mvc:View>
